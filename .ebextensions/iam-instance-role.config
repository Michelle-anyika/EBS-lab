# Custom EC2 instance role/profile for this environment, scoped to read the
# external S3 bucket named by the S3_BUCKET_NAME environment variable (set by
# the GitHub Actions workflow), instead of relying on Elastic Beanstalk's
# broader default EC2 role.
#
# Application-level environment variables (EXTERNAL_SERVICE, S3_BUCKET_NAME)
# are NOT set here — they are owned exclusively by the deploy workflow's
# --option-settings flag so there is a single source of truth and they are
# not silently overwritten by a stale value baked into the source bundle.
Resources:
  ExternalServiceInstanceRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: ebs-lab-instance-role
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/AWSElasticBeanstalkWebTier
      Policies:
        - PolicyName: ExternalS3ReadOnly
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:ListBucket
                Resource:
                  Fn::Sub:
                    - "arn:aws:s3:::${BucketName}"
                    - BucketName:
                        Fn::GetOptionSetting:
                          Namespace: "aws:elasticbeanstalk:application:environment"
                          OptionName: "S3_BUCKET_NAME"
                          DefaultValue: "ebs-lab-no-external-bucket-configured"
              - Effect: Allow
                Action:
                  - s3:GetObject
                Resource:
                  Fn::Sub:
                    - "arn:aws:s3:::${BucketName}/*"
                    - BucketName:
                        Fn::GetOptionSetting:
                          Namespace: "aws:elasticbeanstalk:application:environment"
                          OptionName: "S3_BUCKET_NAME"
                          DefaultValue: "ebs-lab-no-external-bucket-configured"

  ExternalServiceInstanceProfile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      InstanceProfileName: ebs-lab-instance-profile
      Roles:
        - Ref: ExternalServiceInstanceRole

option_settings:
  aws:autoscaling:launchconfiguration:
    IamInstanceProfile: ebs-lab-instance-profile
